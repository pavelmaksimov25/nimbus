# PostgreSQL Database Configuration
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=your_db_name

# PostgreSQL connection string for application
# For docker-compose: use 'database' as hostname
# For local development: use 'localhost' as hostname
DB_DSN="postgres://your_db_user:your_db_password@localhost:5432/your_db_name?sslmode"
