# PostgreSQL Database Configuration
POSTGRES_USER=nimbus
POSTGRES_PASSWORD=nimbus_password
POSTGRES_DB=nimbus_db

# PostgreSQL connection string for application
# For local development (make dev, make run): use 'localhost' as hostname
# For docker-compose (when app runs in container): use 'database' as hostname
DB_DSN=postgres://nimbus:nimbus_password@localhost:5432/nimbus_db?sslmode=disable
