				{
					"name": "Create Workflow",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 201', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test('Response has workflow data', function () {",
									"    var json = pm.response.json();",
									"    pm.expect(json.data).to.have.property('id');",
									"    pm.expect(json.data).to.have.property('name');",
									"    pm.expect(json.data).to.have.property('created_at');",
									"    pm.collectionVariables.set('workflow_id', json.data.id);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"My Workflow\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/workflows",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"workflows"
							]
						}
					}
				}
			]
		},
